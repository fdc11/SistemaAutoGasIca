# Copia este archivo como .env.local y completa con los datos de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web > Configuración del SDK).
# Si lo dejas vacío, el sistema arranca en MODO DEMOSTRACIÓN (datos solo en este navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Consulta de nombres por DNI (https://decolecta.com/profile). SIN el prefijo VITE_ a propósito:
# así el token se queda en el servidor y nunca llega al navegador. No lo pegues en el código.
# En Vercel: Settings > Environment Variables > DECOLECTA_TOKEN.
DECOLECTA_TOKEN=
